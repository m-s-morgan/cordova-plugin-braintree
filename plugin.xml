<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="cordova-plugin-braintree"
        version="1.0.0">

    <name>Braintree Plugin</name>

    <description>
        PayPal and Venmo through the Braintree native SDKs (iOS v7, Android v5): a client token in, a
        payment method nonce out. No Drop-in (Braintree retired it), no card entry, no wallets.
    </description>

    <license>MIT</license>

    <engines>
        <engine name="cordova-ios" version=">=8.0.0" />
        <engine name="cordova-android" version=">=12.0.0" />
    </engines>

    <!-- The universal link / App Link PayPal and Venmo return to: https://$HOST$PATH. The host must
         serve an apple-app-site-association listing "$PATH/*" and an assetlinks.json for the app. -->
    <preference name="BRAINTREE_RETURN_HOST" default="pr.fit" />
    <preference name="BRAINTREE_RETURN_PATH" default="/braintree-payments" />

    <!-- JavaScript Interface -->
    <js-module src="www/braintree-plugin.js" name="BraintreePlugin">
        <clobbers target="BraintreePlugin" />
    </js-module>

    <!-- Android Configuration -->
    <platform name="android">

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="BraintreePlugin">
                <param name="android-package" value="net.justincredible.BraintreePlugin" />
            </feature>
        </config-file>

        <config-file target="res/xml/config.xml" parent="/*">
            <preference name="BraintreeReturnHost" value="$BRAINTREE_RETURN_HOST" />
            <preference name="BraintreeReturnPath" value="$BRAINTREE_RETURN_PATH" />
        </config-file>

        <source-file src="src/android/BraintreePlugin.java" target-dir="src/net/justincredible" />

        <framework src="src/android/build-extras.gradle" custom="true" type="gradleReference" />

        <!-- the browser / app switch returns: the App Link the SDK is given, and the deep-link
             scheme it falls back to (must be the application id followed by .braintree) -->
        <config-file target="AndroidManifest.xml" parent="/manifest/application/activity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="$BRAINTREE_RETURN_HOST" android:pathPrefix="$BRAINTREE_RETURN_PATH" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.braintree" />
            </intent-filter>
        </config-file>

        <!-- the Venmo app, for the app-switch availability check on Android 11+ -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <queries>
                <package android:name="com.venmo" />
            </queries>
        </config-file>

    </platform>

    <!-- iOS Configuration -->
    <platform name="ios">

        <config-file target="config.xml" parent="/*">
            <feature name="BraintreePlugin">
                <param name="ios-package" value="BraintreePlugin" />
            </feature>
        </config-file>

        <config-file target="*-Info.plist" parent="BraintreeUniversalLink">
            <string>https://$BRAINTREE_RETURN_HOST$BRAINTREE_RETURN_PATH</string>
        </config-file>

        <!-- the PayPal and Venmo apps, so the SDK can app-switch to them when installed -->
        <config-file target="*-Info.plist" parent="LSApplicationQueriesSchemes">
            <array>
                <string>paypal</string>
                <string>com.venmo.touch.v2</string>
            </array>
        </config-file>

        <source-file src="src/ios/BraintreePlugin.swift" />

        <podspec>
            <config>
                <source url="https://cdn.cocoapods.org/" />
            </config>
            <pods use-frameworks="true">
                <pod name="Braintree/Core" spec="~> 7.13" />
                <pod name="Braintree/PayPal" spec="~> 7.13" />
                <pod name="Braintree/Venmo" spec="~> 7.13" />
                <pod name="Braintree/DataCollector" spec="~> 7.13" />
            </pods>
        </podspec>

    </platform>

</plugin>
